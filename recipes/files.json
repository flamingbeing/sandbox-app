{
  "module": "files",
  "about": "Photos and files on items (@core/files): offline-first queue, thumbnails, EXIF date; the bytes go to the Worker's R2 bucket (worker/files.js).",
  "root": "recipes/files",
  "importMap": {
    "@core/files": "./files/index.js"
  },
  "vendor": [
    "app/public/vendor/exifr/7.1.3",
    "app/public/vendor/idb-keyval/6.3.0"
  ],
  "files": [
    {
      "from": "app/public/files"
    },
    {
      "from": "app/src/files-data.js"
    },
    {
      "from": "app/src/screens/item-files.js"
    },
    {
      "from": "app/src/screens/attachments.js"
    },
    {
      "from": "app/test/files.unit.test.mjs"
    },
    {
      "from": "e2e/files.spec.mjs"
    },
    {
      "from": "e2e/memory-bucket.mjs"
    },
    {
      "from": "worker/files.js"
    },
    {
      "from": "worker/test/files.test.mjs"
    },
    {
      "to": "app/src/modules.js",
      "after": "// add: imports",
      "line": "import { itemFiles } from './screens/item-files.js';"
    },
    {
      "to": "app/src/modules.js",
      "after": "// add: slots",
      "line": "  itemFiles,"
    },
    {
      "to": "app/src/data-modules.js",
      "after": "// add: imports",
      "line": "import { filesData } from './files-data.js';"
    },
    {
      "to": "app/src/data-modules.js",
      "after": "// add: slots",
      "line": "  files: filesData,"
    },
    {
      "to": "worker/sites.js",
      "after": "// add: worker imports",
      "block": "recipes/files/worker-import.txt"
    },
    {
      "to": "worker/sites.js",
      "after": "// add: worker routes",
      "block": "recipes/files/worker-route.txt"
    },
    {
      "to": "worker/sites.js",
      "after": "// add: worker handlers",
      "block": "recipes/files/worker-handler.txt"
    },
    {
      "to": "app/firestore.app.rules",
      "after": "// add: rules",
      "block": "recipes/files/rules.txt"
    },
    {
      "to": "app/test/rules.test.mjs",
      "after": "// add: rules cases",
      "block": "recipes/files/rules-case.txt"
    },
    {
      "to": "app/test/rules.test.mjs",
      "after": "// add: rules tests",
      "block": "recipes/files/rules-test.txt"
    },
    {
      "to": "app/public/app.css",
      "after": "/* add: css */",
      "block": "recipes/files/app.css.txt"
    },
    {
      "to": "wrangler.jsonc",
      "after": "// add: r2",
      "block": "recipes/files/wrangler-r2.txt"
    },
    {
      "to": "e2e/serve.mjs",
      "after": "// add: e2e imports",
      "line": "import { memoryBucket } from './memory-bucket.mjs';"
    },
    {
      "to": "e2e/serve.mjs",
      "after": "// add: e2e env",
      "line": "  FILES: memoryBucket(),"
    }
  ],
  "tsconfigPaths": {
    "@core/files": [
      "./app/public/files/index.js"
    ]
  },
  "tsconfigInclude": [
    "app/public/files/*"
  ],
  "needs": [
    "make the files bucket once before the first deploy: npx wrangler r2 bucket create <name>-files (the deploy fails without it)"
  ],
  "docs": [
    "files: the data side is app/src/files-data.js, the sheet and list parts are app/src/screens/item-files.js; the Worker route is worker/files.js (100 MB cap, the same ID token check as /api/claims). Rebuild the rules after adding: node .devkit/tools/build-rules.mjs app/firestore.app.rules."
  ]
}
